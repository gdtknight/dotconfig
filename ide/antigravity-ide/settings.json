{
  // ===========================================================================
  // 1. 에디터 기본 및 편집 설정 (Editor Core & Formatting)
  // ===========================================================================
  //#region [Editor Core]
  // 기본 탭 간격 (스페이스 2칸)
  "editor.tabSize": 2,
  // 탭 키 입력 시 탭 문자 대신 공백(스페이스) 삽입
  "editor.insertSpaces": true,
  // 파일 열 때 파일 내용을 분석해 들여쓰기를 자동 감지할지 여부 (사용자 설정 고정을 위해 false)
  "editor.detectIndentation": false,
  // 에디터 기본 글꼴 (Nerd Font 및 아이콘 지원 폰트)
  "editor.fontFamily": "'ComicShannsMono Nerd Font', 'D2CodingLigature Nerd Font'",
  // 줄 번호 표시 모드 (Vim 탐색에 최적화된 상대 줄 번호)
  "editor.lineNumbers": "relative",
  // 커서 이동 시 화면 상/하단에 항상 유지할 최소 여백 라인 수 (Vim scrolloff=8)
  "editor.cursorSurroundingLines": 8,
  // 우측 미니맵(코드 미리보기 바) 표시 여부 (비활성화하여 화면 공간 확보)
  "editor.minimap.enabled": false,
  //#endregion

  // ===========================================================================
  // 2. UI, 테마 및 시각 효과 (UI, Theme & Visuals)
  // ===========================================================================
  //#region [Theme & Vibrancy]
  // 전체 색상 테마
  "workbench.colorTheme": "Default Dark+",
  // OS 시스템 다크 테마 기준 동작
  "window.systemColorTheme": "dark",
  // OS 테마 변경 시 VS Code 테마를 자동 감지하여 변경할지 여부
  "window.autoDetectColorScheme": false,
  // 탐색기(파일 트리) 들여쓰기 픽셀 너비
  "workbench.tree.indent": 12,
  // 탐색기(파일 트리) 들여쓰기 가이드 라인 상시 표시
  "workbench.tree.renderIndentGuides": "always",

  // 에디터 및 UI 투명도 커스터마이징 (투명/반투명 아크릴 효과)
  "workbench.colorCustomizations": {
    // 줄 번호 색상 (반투명 화이트)
    "editorLineNumber.foreground": "#ffffff88",
    // 탭 테두리 (탭 간 구분을 위한 미세한 라인)
    "tab.border": "#ffffff10",
    // 활성 타이틀바 배경 (약한 반투명 블랙)
    "titleBar.activeBackground": "#00000022",
    // 분할 창(Editor Group) 사이의 세로 구분선 (활성 창 영역 식별용)
    "editorGroup.border": "#ffffff33",
    // 사이드바, 액티비티바, 패널, 보조 사이드바 경계선 (미세한 반투명 라인)
    "sideBar.border": "#ffffff15",
    "activityBar.border": "#ffffff15",
    "panel.border": "#ffffff15",
    "auxiliaryBar.border": "#ffffff15",
    // 상태 표시줄 배경
    "statusBar.background": "#00000033",
    // 에디터 탭 헤더 빈 영역, 거터, 에디터 페인 투명 처리
    "editorGroupHeader.tabsBackground": "#00000000",
    "editorGroupHeader.noTabsBackground": "#00000000",
    "editorGutter.background": "#00000000",
    "editorPane.background": "#00000000",

    // [상단 탭 & 분할창 구분 설정]
    // 활성 탭 글자색 (선명한 화이트) vs 비활성 탭 글자색 (차분한 반투명 그레이)
    "tab.activeForeground": "#ffffff",
    "tab.inactiveForeground": "#ffffff66",
    "tab.unfocusedActiveForeground": "#ffffff99",
    // 활성 분할창의 활성 탭 상단 모던 블루 액센트 라인 (한눈에 현재 탭/창 식별)
    "tab.activeBorderTop": "#388bfd",
    // 비활성 분할창에는 액센트 라인을 꺼서 현재 작업 창과 완벽하게 구분
    "tab.unfocusedActiveBorderTop": "#00000000",
    // 활성 탭 배경 (선택된 카드로 돋보이도록 짙은 딥블랙 95%)
    "tab.activeBackground": "#101010f2",
    // 비활성 분할창의 활성 탭 (어둡게 톤 다운)
    "tab.unfocusedActiveBackground": "#10101099",
    // 비활성 탭 배경 (투명하게 낮추어 활성 탭을 강조)
    "tab.inactiveBackground": "#00000044",
    "tab.unfocusedInactiveBackground": "#00000044",

    // 경로 표시줄 (딥블랙 70%) 및 터미널 (중첩 어두워짐 방지를 위해 완전 투명 처리)
    "breadcrumb.background": "#101010b3",
    "terminal.background": "#00000000",

    // 에디터 본문 반투명 배경 (회색 안개 느낌을 없애고 웹뷰와 톤을 일치시키는 딥블랙 35%)
    "editor.background": "#00000059",

    // 사이드바, 보조 사이드바, 액티비티바 (하단 터미널 40%보다 5% 진한 반투명 45%)
    "sideBar.background": "#00000073",
    "sideBarTitle.background": "#00000073",
    "auxiliaryBar.background": "#00000073",
    "auxiliaryBarTitle.background": "#00000073",
    "activityBar.background": "#00000073",
    // 스티키 스크롤(상단 고정 헤더) 배경 (딥블랙 80%)
    "editorStickyScroll.background": "#101010cc",
    "editorStickyScrollGutter.background": "#101010cc",
    "sideBarStickyScroll.background": "#101010cc",
    "panelStickyScroll.background": "#101010cc",
    "terminalStickyScroll.background": "#101010cc",
    "minimap.background": "#101010cc",
    // AI 대화창(Chat View) 배경 (딥블랙 80%)
    "chat.background": "#101010cc",
    "chat.requestBackground": "#101010cc",
    "chat.editor.background": "#101010cc",
    "chat.slashCommandBackground": "#101010cc",
    // 하단 패널 및 섹션 배경 (에디터 35%보다 살짝만 짙은 반투명 40%로 미세 경계 구분)
    "panel.background": "#00000073",
    "panelSection.background": "#00000073",
    "panelSectionHeader.background": "#101010eb",
    // 팝업, 위젯, 제안창, 메뉴, 알림창 배경 (웹뷰 톤과 일치하는 딥블랙 92%)
    "inlineChat.background": "#101010eb",
    "editorWidget.background": "#101010eb",
    "editorHoverWidget.background": "#101010eb",
    "editorSuggestWidget.background": "#101010eb",
    "notifications.background": "#101010eb",
    "notificationCenterHeader.background": "#101010eb",
    "menu.background": "#101010eb",
    "quickInput.background": "#101010eb",
    // 현재 줄 하이라이트 테두리 숨김
    "editor.lineHighlightBorder": "#00000000",
  },

  // background-cover 확장 설정 (에디터 배경 이미지/투명화)
  // 창별 개별 배경 적용 여부
  "backgroundCover.perWindowBackground": false,
  // 배경 크기 배치 모드 (가운데 정렬)
  "backgroundCover.sizeModel": "center",
  // 배경 이미지 블러 강도
  "backgroundCover.blur": 10,
  // 배경 이미지 투명도 (0.05 = 5%)
  "backgroundCover.opacity": 0.2,
  // 배경 이미지 캐시 한도
  "backgroundCover.cacheLimit": 10,

  // indent-rainbow 확장 설정 (들여쓰기 단계별 무지개 가이드라인)
  "indentRainbow.colors": [
    "rgba(255,255,64,0.07)",
    "rgba(127,255,127,0.07)",
    "rgba(255,127,255,0.07)",
    "rgba(79,236,236,0.07)",
  ],
  // 인디케이터 스타일 (라이트 스타일)
  "indentRainbow.indicatorStyle": "light",
  //#endregion

  // ===========================================================================
  // 3. 통합 터미널 (Integrated Terminal)
  // ===========================================================================
  //#region [Terminal]
  // 터미널 글꼴 (Nerd Font)
  "terminal.integrated.fontFamily": "'ComicShannsMono Nerd Font', 'D2CodingLigature Nerd Font'",
  // 터미널 글꼴 크기 (pt)
  "terminal.integrated.fontSize": 13,
  // 터미널 줄 간격 (배율)
  "terminal.integrated.lineHeight": 1.2,
  // 터미널 일반 글꼴 두께
  "terminal.integrated.fontWeight": "normal",
  // 터미널 볼드 글꼴 두께
  "terminal.integrated.fontWeightBold": "bold",
  // 터미널 GPU 가속 비활성화 (투명도/배경 렌더링 글리치 방지)
  "terminal.integrated.gpuAcceleration": "off",
  //#endregion

  // ===========================================================================
  // 4. Vim / Neovim & 단축키 바인딩 (Neovim & Keybindings)
  // ===========================================================================
  //#region [Neovim Mode & WhichKey]
  // macOS Neovim 바이너리 경로 (Homebrew 설치 경로)
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  // Neovim 확장을 별도 확장 호스트 프로세스로 격리하여 입력 지연 및 프레임 드랍 방지
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  // 연속 키 입력 매핑 (Insert 모드에서 'jk' 입력 시 ESC 동작)
  "vscode-neovim.compositeKeys": {
    "jk": {
      "command": "vscode-neovim.escape",
    },
  },
  // which-key 표시 팝업 지연 시간 (0ms = 즉시 반응)
  "whichkey.delay": 0,
  // which-key 메뉴 레이아웃에서 전각 문자 사용 여부
  "whichkey.useFullWidthCharacters": true,
  // 마우스로 메뉴 클릭 시 단축키 생성 추천 팝업 비활성화
  "Key Promoter.suggestKeybindingCreation": false,

