  // ===========================================================================
  // 5. Git & 소스 제어 (Source Control & GitLens)
  // ===========================================================================
  //#region [Git & GitLens]
  // 주기적으로 원격 저장소의 최신 커밋을 자동 fetch
  "git.autofetch": true,
  // Git 바이너리가 감지되지 않을 때 뜨는 경고 메시지 무시
  "git.ignoreMissingGitWarning": true,
  // 소스 제어 뷰에서 저장소 선택 모드 (단일 저장소 포커스)
  "scm.repositories.selectionMode": "single",
  // GitLens AI 기본 에이전트 지정
  "gitlens.ai.defaultAgent": "cli:gemini",
  // GitLens 커밋 그래프 세부 정보 패널 위치 (자동 결정)
  "gitlens.graph.details.location": "auto",
  // 마우스 호버 시 GitLens 블레임 정보를 전체 라인에 걸쳐 감지
  "gitlens.hovers.currentLine.over": "line",
  // 아직 커밋되지 않은 로컬 변경 라인의 GitLens 인라인 블레임 텍스트 포맷
  "gitlens.currentLine.uncommittedChangesFormat": "${author, }${agoOrDate}${' via  'pullRequest}${ • message|50?}",
  //#endregion

  // ===========================================================================
  // 6. 언어별 설정 및 포매터 (Languages & Formatting)
  // ===========================================================================
  //#region [Languages & Tooling]
  // TypeScript 파일 (.ts)
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // React TypeScript 파일 (.tsx)
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // 파일 이동 또는 이름 변경 시 import 경로 자동 업데이트 (항상 적용)
  "typescript.updateImportsOnFileMove.enabled": "always",

  // JavaScript 파일 (.js)
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },
  // React JavaScript 파일 (.jsx)
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },

  // JSON 파일 (.json)
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },
  // 주석이 포함된 JSON 파일 (.jsonc)
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Python 파일 (.py - PEP 8 표준 4칸 공백)
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
  },
  // Python 언어 서버 (Pylance 기본 엔진)
  "python.languageServer": "Default",
  //#endregion

  // ===========================================================================
  // 7. 기타 확장 프로그램 및 보안 (Extensions, Security & Misc)
  // ===========================================================================
  //#region [Extensions & Security]
  // 로컬 파일 프로토콜(file://) 링크 클릭 시 열기 여부 확인 프롬프트 생략
  "security.promptForLocalFileProtocolHandling": false,
  // Red Hat 확장 프로그램의 익명 원격 측정(telemetry) 데이터 전송 허용
  "redhat.telemetry.enabled": false,
  // Claude Code 확장 프로그램의 온보딩 가이드 숨기기
  "claudeCode.hideOnboarding": true,

  // Total TypeScript 확장 팁 설정
  // 모든 팁 숨기기 여부
  "totalTypeScript.hideAllTips": false,
  // 기초 타입 팁 숨기기 여부
  "totalTypeScript.hideBasicTips": false,
  // 숨김 처리할 특정 Total TypeScript 팁 목록
  "totalTypeScript.hiddenTips": [
    "interface-declaration",
    "basic-types",
    "typing-function-parameters",
  ],
  //#endregion
}
